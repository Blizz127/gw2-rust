# GW2 build-209026 server on bansheerealm (stackd readiness_only, always-on).
# systemd --user unit for blizz (linger on), Banshee convention. Install:
#   ~/.config/systemd/user/gw2-server.service ; systemctl --user enable --now gw2-server
# KIT is /home/blizz/gw2-rust-current (symlink to the pinned kit); state is
# /home/blizz/gw2-rust-state (gw2.conf, id/ 0700, run/ 0700).
[Unit]
Description=GW2 build-209026 server (Banshee, readiness_only)

[Service]
Type=simple
ExecStart=/usr/bin/env -i HOME=/home/blizz USER=blizz LOGNAME=blizz LANG=C.UTF-8 PATH=/usr/bin:/bin /bin/bash /home/blizz/gw2-rust-current/deploy/gw2-server.sh /home/blizz/gw2-rust-state/gw2.conf
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
MemoryMax=1G
StandardOutput=append:/home/blizz/gw2-rust-state/run/server.log
StandardError=append:/home/blizz/gw2-rust-state/run/server.log

[Install]
WantedBy=default.target
